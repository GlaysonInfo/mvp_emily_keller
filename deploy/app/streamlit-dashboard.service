[Unit]
Description=AutomacaoAPI Streamlit Dashboard (IHM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/automacaoapi
EnvironmentFile=/opt/automacaoapi/.env
# Liga somente em 127.0.0.1: o acesso externo passa pelo nginx + oauth2-proxy.
ExecStart=/opt/automacaoapi/.venv/bin/python -m streamlit run src/dashboard/app.py \
  --server.address 127.0.0.1 \
  --server.port 8501 \
  --server.headless true \
  --browser.gatherUsageStats false
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
