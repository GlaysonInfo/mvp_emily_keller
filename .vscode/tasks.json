{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run OPC UA simulator",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "simulator.opcua_server"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run Edge Bridge",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "edge_bridge.main"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Run Mosquitto",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "mosquitto"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    }
  ]
}
